# MindMittel V2 Environment Configuration
# Copy this file to .env.local and fill in your credentials

# Google Gemini API Key (Default platform key; tenants can also configure dedicated keys)
GEMINI_API_KEY="your_gemini_api_key_here"

# Primary MongoDB Atlas Connection URI (Control Plane + Default Multi-Tenant Cluster)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mindmittel2?retryWrites=true&w=majority"
MONGODB_DB_NAME="mindmittel_v2"

# Multi-Tenant Root Domain & Product Owner Control Plane (admin.mindmittel.de)
NEXT_PUBLIC_ROOT_DOMAIN="mindmittel.de"
SUPER_ADMIN_EMAIL="amir.doorandish@gmail.com"
SUPER_ADMIN_PASSWORD="change_me_in_production"
MASTER_ENCRYPTION_KEY="32_char_random_master_key_for_aes_256_gcm"

# Amazon SMTP (SES / Mail Manager) Configuration for Live 6-Digit OTP Emails
SMTP_HOST="your-endpoint.mail-manager-smtp.amazonaws.com"
SMTP_PORT="587"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="MindMittel Security <security@mindmittel.de>"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://mindmittel.de"

# Optional Security Token for /system Live Dashboard in Production
SYSTEM_DASHBOARD_TOKEN="dev_admin_token_change_in_prod"
