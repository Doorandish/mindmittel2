# MindMittel V2 Environment Configuration
# Copy this file to .env.local and fill in your credentials

# Google Gemini API Key (Required for AI features & dynamic model selection)
GEMINI_API_KEY="your_gemini_api_key_here"

# MongoDB Atlas Connection URI (Database: mindmittel_v2)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mindmittel_v2?retryWrites=true&w=majority"
MONGODB_DB_NAME="mindmittel_v2"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Security Token for /system Live Dashboard in Production
SYSTEM_DASHBOARD_TOKEN="dev_admin_token_change_in_prod"
